#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        screenshot_mac {
            bindings = <&kp LS(LC(X))>;
            key-positions = <40 41 39>;
        };

        screenshot_windows {
            bindings = <&kp LS(LG(S))>;
            key-positions = <40 39 38>;
        };

        alt_delete {
            bindings = <&kp DEL>;
            key-positions = <11 10>;
        };

        alt_tilda {
            bindings = <&kp TILDE>;
            key-positions = <0 1>;
        };

        toggle_layer_4 {
            bindings = <&tog 4>;
            key-positions = <59 55>;
        };
    };

    macros {
        macro_right_arrow: macro_right_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "MACRO_RIGHT_ARROW";
        };

        macro_left_arrow: macro_left_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp MINUS>;
            label = "MACRO_LEFT_ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "(O ~ O)";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3     &kp N4     &kp N5                         &kp N6  &kp N7     &kp N8     &kp N9     &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W     &kp E      &kp R      &kp T                          &kp Y   &kp U      &kp I      &kp O      &kp P     &kp BSLH
&kp LSHFT  &kp A   &kp S     &kp D      &kp F      &kp G                          &kp H   &kp J      &kp K      &kp L      &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X     &kp C      &kp V      &kp B     &kp C_MUTE    &none  &kp N   &kp M      &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LCTRL  &kp SPACE  &kp LALT  &mo 1         &mo 2  &mo 3   &kp SPACE  &kp RALT   &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "<(O ~ O<)";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp GRAVE  &kp F1   &kp F2      &kp F3     &kp F4      &kp F5                        &trans  &trans  &trans  &trans  &trans  &trans
&kp GRAVE  &kp F6   &kp F7      &kp F8     &kp F9      &kp F10                       &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp F11  &kp F12     &kp ENTER  &kp BSPC    &kp DELETE                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans   &kp C_PREV  &kp C_PP   &kp C_NEXT  &kp LA(F4)  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans      &trans     &trans      &trans      &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "\(Q o Q\)";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3        &bt BT_SEL 4                    &kp LC(F13)  &kp LC(F14)  &kp LC(F15)  &kp LC(F16)  &trans  &kp DEL
&trans     &kp INS       &kp PSCRN     &kp LS(TAB)   &trans              &trans                          &kp HOME     &trans       &kp UP       &trans       &trans  &trans
&trans     &trans        &trans        &kp TAB       &kp LG(LEFT_SHIFT)  &kp CLCK                        &kp END      &kp LEFT     &kp DOWN     &kp RIGHT    &trans  &trans
&trans     &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE         &trans        &trans    &trans  &trans       &trans       &trans       &trans       &trans  &kp ENTER
                         &trans        &trans        &trans              &trans        &trans    &trans  &trans       &trans       &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "(/O 3 O)/";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none                 &none                  &none              &none               &none  &kp DELETE
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS           &kp UNDERSCORE      &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp MINUS          &kp EQUAL           &none  &none
&none              &none            &none            &none            &none            &none            &rgb_ug RGB_TOG    &none  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &macro_left_arrow  &macro_right_arrow  &none  &kp ENTER
                                    &none            &none            &rgb_ug RGB_TOG  &none            &none              &none  &none                 &none                  &none              &none
            >;
        };

        layer_4 {
            display-name = "/(T m T)\\";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &kp STAR  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp N7  &kp N8    &kp N9  &kp PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp N4  &kp N5    &kp N6  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp N1  &kp N2    &kp N3  &kp FSLH   &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp N0  &trans    &trans
            >;
        };
    };
};
